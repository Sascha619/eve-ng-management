# Umgebung für lokale ansible-tam-Läufe gegen das Lab:
#   source ~/Repos/eve-ng-management/lab/ansible-tam.env
#   cd ~/Repos/ansible-tam/ansible
#   ansible-playbook -i inventory/hosts_lab.yml playbooks/pve_nat.yml
#
# NETBOX_URL/-TOKEN und ROUTEROS_PASSWORD haben in hosts_lab.yml bereits
# Lab-Defaults; ROUTEROS_USER nicht (die Skripte verlangen es explizit).
export ROUTEROS_USER=admin
export NETBOX_URL=http://localhost:8001
export NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567

# Plays mit connection: local würden sonst das System-Python nehmen, dem
# librouteros/netaddr fehlen — die liegen in der venv von ansible-tam.
export ANSIBLE_PYTHON_INTERPRETER="$HOME/Repos/ansible-tam/.venv/bin/python"
export PATH="$HOME/Repos/ansible-tam/.venv/bin:$PATH"
